---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProductPreview from '../components/ProductPreview.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CompanionApp from '../components/CompanionApp.astro';
import WhereToBuy from '../components/WhereToBuy.astro';
import FlashSection from '../components/FlashSection.astro';
import ReleaseNotes from '../components/ReleaseNotes.astro';
import Specs from '../components/Specs.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="ScryBar — Your desk knows things now." description="Your desk knows things now. An open-source desk companion for time, weather, music and the things you keep an eye on. Seven themes, fourteen clock languages, and your own swipe order.">
  <Nav />
  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title"><div class="container">
      <div class="hero-copy"><h1 id="hero-title">Desk, meet<br />ScryBar.</h1><div class="hero-intro"><p>Your desk knows things now. An open-source desk companion for time, weather, music and the things you keep an eye on.</p><a class="button" href="#flash">Install firmware</a></div></div>
      <ProductPreview />
    </div></section>
    <Features /><HowItWorks /><CompanionApp /><WhereToBuy /><FlashSection />
    <section id="questions" class="chapter"><div class="container faq-layout"><h2>A few good<br />questions</h2><div class="disclosures">
      <details><summary>Does it need a Mac?</summary><p>Clock, weather, RSS, Wikipedia, departures and launches run on ScryBar. Now Playing, Mac Stats and Bambu features use Companion on a Mac.</p></details>
      <details><summary>Can I configure it from my phone?</summary><p>Yes. Join the setup network or open ScryBar’s configuration page on your LAN. Installing firmware needs a desktop browser with Web Serial support.</p></details>
      <details><summary>Can I hide or reorder pages?</summary><p>Yes. Choose the views you want and set their swipe order in the Control Surface. The panel marks views that must stay available.</p></details>
      <details><summary>Where is the source?</summary><p>The firmware, Companion and website are in the <a href="https://github.com/enuzzo/scrybar">ScryBar repository</a>. Read its license and third-party notices before reusing code or assets.</p></details>
    </div></div></section>
    <section class="chapter technical"><div class="container"><h2>For the curious</h2><p class="section-intro">Hardware details and the published release history.</p><div class="technical-grid"><details><summary>Hardware specifications</summary><Specs /></details><details><summary>Published firmware releases</summary><ReleaseNotes /></details></div></div></section>
  </main><Footer />
</Layout>
