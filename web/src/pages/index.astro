---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import DeviceMockup from '../components/DeviceMockup.astro';
import ThemeSelector from '../components/ThemeSelector.astro';
import LanguagePreview from '../components/LanguagePreview.astro';
import Features from '../components/Features.astro';
import ViewShowcase from '../components/ViewShowcase.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CompanionApp from '../components/CompanionApp.astro';
import WhereToBuy from '../components/WhereToBuy.astro';
import FlashSection from '../components/FlashSection.astro';
import ReleaseNotes from '../components/ReleaseNotes.astro';
import Specs from '../components/Specs.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="ScryBar — Your desk knows things now."
  description="An open-source ESP32-S3 desk companion with a 14-language word clock, live weather, news, Now Playing, transit, launches, and Mac stats."
>
  <div class="page-glow" aria-hidden="true"></div>
  <div class="page-noise" aria-hidden="true"></div>

  <div class="content">
    <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container">
        <Nav />

        <div class="hero-content">
          <div class="hero-badges entrance entrance--2">
            <span class="vm-badge vm-badge--brand">ESP32-S3</span>
            <span class="vm-badge vm-badge--info">Open Source</span>
          </div>

          <h1 id="hero-title" class="entrance entrance--3">
            Your desk knows<br />
            things now.
          </h1>
          <p class="hero-lede entrance entrance--4">
            A mass of sensors, pixels, and unresolved ambition,
            pretending to be furniture. Word clock in 14 languages,
            weather, news, Wikipedia, Now Playing from macOS, live
            public-transport timetable, rocket launch countdowns,
            and Mac stats &mdash; on a 3.49&quot; IPS touchscreen.
          </p>

          <div class="hero-ctas entrance entrance--5">
            <a href="#flash" class="vm-btn vm-btn--primary vm-btn--lg">
              Flash Firmware
            </a>
            <a href="#features" class="vm-btn vm-btn--secondary vm-btn--lg">
              Explore Features
            </a>
          </div>
        </div>

        <div class="entrance entrance--6">
          <DeviceMockup />
        </div>

        <div class="entrance entrance--7">
          <ThemeSelector />
        </div>

        <div class="entrance entrance--8">
          <LanguagePreview />
        </div>
      </div>
    </section>

    <div class="reveal">
      <ViewShowcase />
    </div>

    <div class="reveal">
      <Features />
    </div>

    <div class="reveal">
      <HowItWorks />
    </div>

    <div class="reveal">
      <CompanionApp />
    </div>

    <div class="reveal">
      <WhereToBuy />
    </div>

    <div class="reveal">
      <FlashSection />
    </div>

    <div class="reveal">
      <ReleaseNotes />
    </div>

    <div class="reveal">
      <Specs />
    </div>

    </main>
    <Footer />
  </div>
</Layout>

<script>
  const reveals = document.querySelectorAll('.reveal');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!('IntersectionObserver' in window) || reduceMotion) {
    reveals.forEach((el) => el.classList.add('revealed'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );
    reveals.forEach((el) => observer.observe(el));
  }
</script>
