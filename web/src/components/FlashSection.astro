---
import manifest from '../../public/manifest.json';
const manifestPath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/manifest.json`;
---
<section id="flash" class="chapter installer"><div class="container installer-layout"><div><h2>Install ScryBar</h2><p class="section-intro">Connect the board by USB-C. The installer asks you to choose its serial port.</p><p>Published firmware {manifest.version}. The previews above can show newer development firmware.</p></div><div class="installer-panel"><h3>Ready for your board</h3><esp-web-install-button manifest={manifestPath}><button id="js-flash-activate" slot="activate" class="button" aria-describedby="js-flash-status" disabled>Install firmware</button></esp-web-install-button><p id="js-flash-status" role="status">Loading installer…</p><button id="js-flash-retry" class="quiet-button" type="button" hidden>Try again</button><details><summary>Board not detected?</summary><p>Hold <kbd>BOOT</kbd>, press and release <kbd>RST</kbd>, then release <kbd>BOOT</kbd>. Try the installer again. Also check that your cable carries data.</p></details><details><summary>After installation</summary><ol><li>Join the device’s <code>ScryBar-Setup-XXXX</code> Wi-Fi network.</li><li>Open <code>http://192.168.4.1:8080</code>.</li><li>Choose Wi-Fi, theme, language, location and the views you want.</li></ol></details><p class="installer-mobile-note">You can configure ScryBar from your phone after installing firmware from a supported desktop browser.</p></div></div></section>
<script>
 const status=document.getElementById('js-flash-status')!;
 const activate=document.getElementById('js-flash-activate') as HTMLButtonElement;
 const retry=document.getElementById('js-flash-retry') as HTMLButtonElement;
 const supportsSerial='serial' in navigator;
 let attempt=0;
 function loadInstaller(){
  if(!window.isSecureContext){status.textContent='Open the HTTPS version of this page to use the installer.';activate.hidden=true;return;}
  if(!supportsSerial){status.textContent='This browser cannot install firmware. Use a desktop browser with Web Serial support. You can configure ScryBar from your phone after installation.';activate.hidden=true;return;}
  if(document.querySelector('script[data-esp-web-tools]'))return;
  status.textContent='Loading installer…';retry.hidden=true;
  const script=document.createElement('script');script.type='module';script.dataset.espWebTools='';
  // Browsers cache failed module fetches for the life of the document.
  // A fresh URL lets a retry actually request the loader again.
  const retryQuery=attempt++ ? `&retry=${attempt}` : '';
  script.src=`https://unpkg.com/esp-web-tools@10.2.1/dist/web/install-button.js?module${retryQuery}`;
  let finished=false;
  const fail=()=>{if(finished)return;finished=true;script.remove();activate.disabled=true;status.textContent='The installer could not load. Check your connection and try again.';retry.hidden=false;};
  const timeout=window.setTimeout(fail,15000);
  script.addEventListener('error',()=>{window.clearTimeout(timeout);fail();},{once:true});
  script.addEventListener('load',async()=>{await customElements.whenDefined('esp-web-install-button');if(finished)return;finished=true;window.clearTimeout(timeout);activate.disabled=false;status.textContent='Installer ready. Connect ScryBar by USB-C.';},{once:true});
  document.head.appendChild(script);
 }
 retry.addEventListener('click',loadInstaller);
 loadInstaller();
</script>
