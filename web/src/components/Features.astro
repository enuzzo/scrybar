---
const features = [
  { icon: '\u{1F550}', title: 'Word Clock',    desc: 'Natural-language time in 14 languages. From Italian to Klingon to Pirate English. Real grammar, not tiles.' },
  { icon: '\u{1F324}', title: 'Live Weather',  desc: 'Current conditions and three-hour outlook. Location configurable. Refreshes every 15 minutes.' },
  { icon: '\u{1F4F0}', title: 'RSS Feeds',     desc: 'Up to 5 news feeds with live favicons and a QR to finish the article on your phone.' },
  { icon: '\u{1F4DA}', title: 'Wikipedia',     desc: 'Featured, On This Day, random discoveries. 8 languages. Trivia you didn\u2019t ask for, delivered anyway.' },
  { icon: '\u{1F3B5}', title: 'Now Playing',   desc: 'macOS companion pipes the system-wide Now Playing session. Album art, progress bar, source tag.' },
  { icon: '\u{1F689}', title: 'Timetable',     desc: 'Live departures worldwide via Transitous. Countdown in prime notation, like the LED at a real bus stop. No API key.' },
  { icon: '\u{1F680}', title: 'Launches',      desc: 'Rocket countdown hero with pad weather and a QR to the mission page. Know the moment SpaceX slips again.' },
  { icon: '\u{1F5A5}',  title: 'Mac Stats',    desc: 'CPU/GPU load and temps, RAM and disk bars, pushed from the companion. Activity Monitor, but ambient.' },
  { icon: '\u{1F3A8}', title: '7 Themes',      desc: 'From deep navy to cyberpunk neon to CRT phosphor. One selector drives both device and web UI.' },
  { icon: '\u{1F4E1}', title: 'LAN Config',    desc: 'Full web control surface over Wi\u2011Fi. Theme, language, feeds, weather, brightness \u2014 no reflash.' },
];
---
<section id="features">
  <div class="container">
    <span class="section-label">Capabilities</span>
    <h2>Everything on a 3.49" bar</h2>
    <p class="section-sub">
      Ten things your desk does for free, one horizontal bar.
      Toggle any of them off from the web UI and the carousel
      just closes ranks.
    </p>

    <div class="features-grid">
      {features.map((f, i) => (
        <div
          class="vm-card feature-card"
          style={`animation-delay: ${i * 60}ms`}
        >
          <span class="feature-icon">{f.icon}</span>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
