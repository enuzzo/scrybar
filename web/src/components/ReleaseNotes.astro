---
const releases = [
  {
    version: 'v0.9.5',
    tag: 'r322',
    date: '2026-10-23',
    headline: 'Smoother page motion, richer Mac Stats and mobile web controls',
    items: [
      { label: 'Perf', text: 'Page slides reached approximately 60 fps during active motion with zero missed periods in the measured device trials. HTTP parsing and sending run away from the visual loop; cache preparation and handoff have separate timing costs.', href: 'https://github.com/enuzzo/scrybar/blob/main/docs/performance/2026-10-23-frame-pacing.md' },
      { label: 'New', text: 'Mac Stats gives download and upload a shared-scale 60-second trace at real sample timestamps, with scope and leading-app rates. Unknown data stays distinct from measured idle.' },
      { label: 'UI', text: 'Seven-theme contrast, display copy and alignment pass, plus a rebuilt product page and phone-friendly Control Surface. Reload keeps pending choices, and live brightness remains unsaved until Save changes.', href: 'https://github.com/enuzzo/scrybar/blob/main/docs/design/2026-10-23-webui/QA.md' },
      { label: 'Fix', text: 'Companion 0.3.15 (53) reads the current player’s own artwork through a bundled MediaRemote reader, keeping source, track and album identity together. Covers refresh after a display restart, and late artwork updates the preview. Meguru HD is optional: the source must contain at least 512 pixels and match the current cover; smaller images are not enlarged into HD.' },
    ],
  },
  {
    version: 'v0.9.4',
    tag: 'r307',
    date: '2026-09-09',
    headline: 'Reliable page swipes and estimated print finish time',
    items: [
      { label: 'Fix', text: 'Page drags select the next view reliably instead of snapping back. Slow drags remain valid, and touch release timing is independent of rendering and network load.' },
      { label: 'New', text: 'Companion v0.3.5 shows the estimated print finish day and local time alongside remaining time, while a print is active.' },
    ],
  },
  {
    version: 'v0.9.3',
    tag: 'r306',
    date: '2026-09-08',
    headline: 'Bambu camera on demand, with clear light controls',
    items: [
      { label: 'New', text: 'Watch an A1/P1 printer from ScryBar or Companion v0.3.4, without Bambu Studio. Both viewers share one LAN camera stream.' },
      { label: 'New', text: 'Closing the last camera viewer stops the stream and requests light-off, with persisted cleanup and retry after reconnection.' },
      { label: 'UI', text: 'A clearer CAM button, aligned status badges and FINISHED label. The device camera separates Light: ON/OFF from Turn on/off and keeps Back as its only exit control.' },
      { label: 'Fix', text: 'More reliable camera taps, clean Connecting text and restored grayscale edges on the Netmilk boot logo.' },
    ],
  },
  {
    version: 'v0.9.2',
    tag: 'r302',
    date: '2026-09-06',
    headline: 'Bambu connection recovery and filament telemetry',
    items: [
      { label: 'Fix', text: 'Companion v0.3.3 restarts rate-limited discovery after network failures and uses the saved LAN name as a fallback after printer serial matching.' },
      { label: 'New', text: 'The Bambu display rotates through print filament labels and colors. Companion and firmware show observed settled filament changes, with a total when supplied by the printer.' },
    ],
  },
  {
    version: 'v0.9.1',
    tag: 'r301',
    date: '2026-09-02',
    headline: 'Stable Bambu identity and automatic IP recovery',
    items: [
      { label: 'Fix', text: 'Companion v0.3.2 identifies a saved Bambu printer by serial before considering a selected or previously saved IP. DHCP address changes now update the stored endpoint and reconnect MQTT automatically.' },
      { label: 'Fix', text: 'Bare SSDP echoes without a Bambu serial or model are rejected, so false printer entries can no longer suppress the verified LAN-service fallback scan.' },
      { label: 'Fix', text: 'Manual-IP selection remains available for segmented networks, while the normal path prefers the richer LAN identity and preserves the access code in macOS Keychain.' },
    ],
  },
  {
    version: 'v0.9.0',
    tag: 'r300',
    date: '2026-09-02',
    headline: 'Bambu Lab telemetry, animated Meteocons, reorderable views',
    items: [
      { label: 'New', text: 'Bambu Lab page — live job and stage, progress, remaining time, layers, nozzle/bed/chamber temperatures, speed, fans, Wi-Fi, filament and AMS telemetry, with alert states on the physical 640×172 display.' },
      { label: 'New', text: 'Companion v0.3.1 connects to a Bambu printer over local MQTT/TLS, keeps the LAN access code in macOS Keychain, forwards a sanitized payload to ScryBar, and can play distinct start, blocked and finished sounds.' },
      { label: 'New', text: 'Views can now be reordered from the device web UI. The validated sequence persists in NVS and drives the real physical swipe carousel, including Home and Bambu.' },
      { label: 'Fix', text: 'Printer discovery deduplicates the same printer advertised under multiple Bonjour identities; Settings now exposes clear discovery, selection, retry, connection status and setup help.' },
      { label: 'Fix', text: 'Mobile web config no longer inherits desktop sticky-footer margins, eliminating horizontal overflow while keeping 42 px reorder controls.' },
      { label: 'New', text: 'Physical-display typography now uses Dosis Regular and SemiBold, generated independently from the official SIL OFL 1.1 font source with full Latin Extended coverage.' },
      { label: 'Polish', text: 'Bambu progress is larger and cleaner: the filename remains in the rotating footer, while telemetry captions use readable Title Case.' },
      { label: 'New', text: 'Home weather now uses 19 full-color Meteocons variants driven by live Open-Meteo WMO codes, including day/night states, fog, precipitation intensity, sleet, snow, thunderstorms and hail. The current icon is animated on-device; the compact forecast stays still.' },
      { label: 'Fix', text: 'Bambu print stage and connection state now sit on compact near-black header badges. Printing stays white, while Running and its indicator use Bambu green with reliable contrast across bright themes such as Tokyo Transit.' },
      { label: 'Polish', text: 'Primary on-device header titles now use Dosis SemiBold at 20 px: one restrained size step up from Regular 18 px, while secondary status, time and metadata retain their existing hierarchy.' },
      { label: 'Polish', text: 'Bambu print progress now fills its left rail with a vertically centred 126 px ring, a wider and lighter remaining track, rounded green endpoints, and larger SemiBold telemetry captions.' },
      { label: 'Polish', text: 'A full physical-view typography audit aligned Now Playing with the Dosis hierarchy: its compact header is now SemiBold 18 px, track titles use SemiBold 25 px, and the artist follows the actual one- or two-line title height instead of a fixed empty gap.' },
      { label: 'Polish', text: 'Bambu progress now retains 8 px of breathing room above and below its body-centred ring. The rotating telemetry footer uses Dosis 18 px with Bambu-green labels and white values/separators for faster scanning.' },
      { label: 'Polish', text: 'Weather Meteocons are tightly cropped at native 84 px and animate at a calmer 5 fps only while Home is visible. The three-hour forecast uses a crisp monochrome 30 px icon with automatic contrast across every theme.' },
      { label: 'Fix', text: 'Now Playing restores album artwork even when a player exposes no native cover identifier: Companion v0.3.1 build 36 creates a stable local artwork identity, while the physical view now shows the album title beneath the artist when available.' },
      { label: 'Fix', text: 'Now Playing duration is positioned relative to the live sync label, preventing the longer Out of Sync state from colliding with the time in the compact header.' },
      { label: 'Polish', text: 'Home weather now uses a dark theme-tinted surface across all seven themes. Current Meteocons gain stronger contrast, while a subtly lifted forecast rail and automatic soft-white text preserve hierarchy on the 640×172 display.' },
      { label: 'Fix', text: 'Companion v0.3.1 sizes its popover from the display’s real usable height. It now opens tall enough for its content whenever space permits and scrolls only when the screen is genuinely too short.' },
    ],
  },
  {
    version: 'v0.8.2',
    tag: 'r283',
    date: '2026-07-21',
    headline: 'Snappiness overhaul, touch quality pass, Companion quit & clean shutdown',
    items: [
      { label: 'Perf', text: 'LVGL draw buffer moved to internal SRAM — 3.7× faster render handler. Page-visibility steady-state caching and Mac Stats change detection skip re-rendering anything that didn’t change.' },
      { label: 'Fix', text: 'Switching themes leaked a PSRAM buffer on every switch on pages with a QR canvas — the canvas buffer is now reused instead of recreated.' },
      { label: 'Fix', text: 'Touch classification tightened: the fast-swipe shortcut is gone (it could misread slow taps as page swipes), and NXT / SKIP / QR buttons use precise 8×2 px hit padding so a tap near a shared edge dispatches only its own action.' },
      { label: 'New', text: 'Companion v0.2.4 — quit the app directly from the popover (power icon next to the gear) or from the Settings footer. Termination is clean: polling stops and the macmon subprocess is terminated, never orphaned.' },
      { label: 'Fix', text: 'Companion status is now truthful: “Connected” only after a successful send to the device in the last 8 seconds, otherwise “Waiting” with an amber dot. macmon runs as one long-lived pipe instead of a new process every 5 s.' },
      { label: 'Fix', text: 'INFO page density pass — all six rows fit without clipping. Now Playing shows an honest stale state when live data stops flowing.' },
    ],
  },
  {
    version: 'v0.8.1',
    tag: 'r279',
    date: '2026-04-23',
    headline: 'Now Playing color fix, header polish, web gallery refresh',
    items: [
      { label: 'Fix', text: 'Now Playing album art colors were corrupted — golden/amber tones (e.g. STARBOY) appeared pure red. Root cause: companion used CGBitmapContext with byteOrder32Big|premultipliedLast, which is not hardware-accelerated on Apple Silicon. Core Graphics renders BGRA regardless, zeroing the G high bits for warm colors. Fixed by using the native byteOrder32Little|premultipliedFirst (BGRA) format.' },
      { label: 'Fix', text: 'Now Playing header strip: title and status were offset +2px downward, pressing them against the divider above the album art. All four label objects now use y\u2009=\u20090 so the strip reads as vertically centered.' },
      { label: 'Fix', text: 'Launches hero: country label enlarged from 14\u202fpx to 16\u202fpx; TAP\u00b7SCAN QR hint opacity raised from 70\u202f% to 90\u202f% for better legibility at a glance.' },
      { label: 'New', text: 'Features section redesigned as horizontal cards — icon on the left, title and description stacked on the right, four columns across. \u201c7\u202fThemes\u201d and \u201cLAN Config\u201d removed; both are already covered elsewhere on the page.' },
      { label: 'New', text: 'View gallery refreshed: companion screenshot removed (shown in the Companion section below), device bezel frames added around each image. All 8 screenshots recaptured with London weather, English word clock, Liverpool Street Station for Timetable, and a different theme per view.' },
    ],
  },
  {
    version: 'v0.8.0',
    tag: 'r277',
    date: '2026-04-23',
    headline: 'Timetable rename, prime-notation countdown, DST bug fix',
    items: [
      { label: 'New', text: 'The Departures page is now Timetable. Scheduled HH:MM is replaced by a real countdown in prime notation — 3\u2032, 14\u2032, 45\u2032 — that ticks every minute. Over an hour away you get the absolute time back; imminent departures go amber. Just like the LED at a real bus stop.' },
      { label: 'Fix', text: 'Every transit time was an hour in the future during Central European Summer Time. Root cause was a stack of throwaway mktime() calls in the ISO parser that left newlib\u2019s DST state inconsistent, so localtime_r applied the savings hour twice. Parser rewritten; stoptimes query now uses time(nullptr). Year-round correct under CET and CEST.' },
      { label: 'New', text: 'Landing page now shows all nine views in a three-column grid so you can see what you\u2019re flashing before you flash it.' },
      { label: 'Fix', text: 'Launches page, compact row view: the provider pill now fills the full row height with 20 px breathing room between the pill and the mission data. No more half-height pill floating above triple-height text.' },
      { label: 'New', text: 'Serial command aliases: TIMETABLE and VIEWTIMETABLE also jump to the transit page (the legacy TRANSIT / VIEWTRANSIT still work).' },
    ],
  },
  {
    version: 'v0.7.0',
    tag: 'r274',
    date: '2026-04-22',
    headline: 'Mac Stats page, Companion v0.2.1, landing redesign',
    items: [
      { label: 'New', text: 'Mac Stats page — live CPU/GPU usage and temperature, RAM and disk bars, pushed from the companion app over LAN. Sparkline history, chunky segmented bars, color-coded Good/Warm/Hot status.' },
      { label: 'New', text: 'ScryBar Companion v0.2.1 with a synthwave app icon, Mac Stats section in the menu-bar popover, and macmon integration for Apple Silicon CPU/GPU temperatures (no sudo).' },
      { label: 'New', text: 'Landing page Companion section redesigned: cinematic icon hero, faux-macOS popover window, four-step first-launch flow, Terminal shortcut for skipping Gatekeeper.' },
      { label: 'Fix', text: 'Curly quotes, em-dashes, and ellipsis in podcast and RSS titles no longer render as tofu squares — sanitized to ASCII before LVGL display.' },
      { label: 'Fix', text: 'Mac Stats sparklines and progress bars were invisible at boot (LVGL bg_opa default). Contrast tuned across all seven themes — LIVE label and track segments always legible.' },
    ],
  },
  {
    version: 'v0.6.0',
    tag: 'r262',
    date: '2026-04-21',
    headline: 'Brightness control, unified screensaver, touch fix',
    items: [
      { label: 'New', text: 'Dual brightness sliders in the web UI — separate levels for USB-C and battery, live-apply while dragging.' },
      { label: 'New', text: 'Unified Pasture screensaver. Nordic Night palette across every theme, four fixed zones, cow that grazes and sleeps. No more grass-vs-clock overlap.' },
      { label: 'Fix', text: 'Rapid-tapping the Wikipedia page no longer sneaks the screensaver in. Root cause was a uint32_t underflow in a cross-handler race — fixed and flagged as a CRITICAL gotcha in the repo.' },
      { label: 'Fix', text: 'Departures toggle in the web UI now actually disables the page. Launches gets its own checkbox (previously always-on).' },
    ],
  },
  {
    version: 'v0.5.0',
    tag: 'r256',
    date: '2026-04-10',
    headline: 'Launches page, Cinematic hero, font unification',
    items: [
      { label: 'New', text: 'Rocket launches page with cinematic countdown hero, weather at the pad, and a QR jump to mission details.' },
      { label: 'New', text: 'Typography unified on Funnel Display (Regular + SemiBold), with Latin Extended coverage for international station and mission names.' },
      { label: 'Fix', text: 'Launch metadata parser handles the full Launch Library 2 shape — no more NET-only placeholders when precise T-0 data is available.' },
    ],
  },
];

const [latest, ...older] = releases;
---
<section id="changelog">
  <div class="container">
    <span class="section-label">What's new</span>
    <h2>Recent releases</h2>
    <p class="section-sub">
      Full history in <a href="https://github.com/enuzzo/scrybar/releases" target="_blank" rel="noopener noreferrer">GitHub Releases</a>.
    </p>

    <div class="releases">
      <article class="vm-card release release--latest">
        <header class="release__head">
          <div class="release__title">
            <h3>{latest.version}</h3>
            <span class="published-label">Published release</span>
            <span class="release__tag">{latest.tag}</span>
          </div>
          <time class="release__date" datetime={latest.date}>{latest.date}</time>
        </header>
        <p class="release__headline">{latest.headline}</p>
        <ul class="release__items">
          {latest.items.map((item) => (
            <li>
              <span class={`release__label release__label--${item.label.toLowerCase()}`}>
                {item.label}
              </span>
              <span class="release__text">{item.text}{'href' in item && <> <a href={item.href}>Details and validation</a>.</>}</span>
            </li>
          ))}
        </ul>
      </article>

      {older.length > 0 && (
        <details class="releases__older">
          <summary class="releases__toggle">
            <span class="releases__toggle-label">
              Show {older.length} previous release{older.length === 1 ? '' : 's'}
            </span>
            <span class="releases__toggle-versions">
              {older.map((r, i) => (
                <span>{i > 0 ? ' · ' : ''}{r.version}</span>
              ))}
            </span>
            <svg class="releases__toggle-chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="releases__older-list">
            {older.map((r) => (
              <article class="vm-card release">
                <header class="release__head">
                  <div class="release__title">
                    <h3>{r.version}</h3>
                    <span class="release__tag">{r.tag}</span>
                  </div>
                  <time class="release__date" datetime={r.date}>{r.date}</time>
                </header>
                <p class="release__headline">{r.headline}</p>
                <ul class="release__items">
                  {r.items.map((item) => (
                    <li>
                      <span class={`release__label release__label--${item.label.toLowerCase()}`}>
                        {item.label}
                      </span>
                      <span class="release__text">{item.text}{'href' in item && <> <a href={item.href}>Details and validation</a>.</>}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </details>
      )}
    </div>
  </div>
</section>

<style>
.releases{display:grid;gap:20px;margin-top:16px}.release{background:none;padding:0}.release__head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:12px}.release__title{display:flex;flex-wrap:wrap;align-items:baseline;gap:12px}.release__title h3{font-size:22px}.published-label,.release__tag,.release__date{font-size:13px;color:var(--text-secondary)}.release__headline{font-size:16px;margin:16px 0;color:var(--text-primary)}.release__items{padding-left:18px;font-size:16px}.release__label{display:none}.release__text{color:var(--text-secondary)}.releases__older{padding:0;background:none}.releases__toggle-versions{display:none}.releases__toggle-chevron{display:none}.releases__older-list{display:grid;gap:32px;padding-top:20px}.release__title{margin-top:12px}.section-sub{font-size:14px}
</style>
