---
import { CircleCheck, PlugZap, Wifi, Zap } from '@lucide/astro';

const steps = [
  { num: '1', icon: PlugZap,     title: 'Plug In', desc: 'Connect USB-C to your device and computer.' },
  { num: '2', icon: Zap,         title: 'Flash',   desc: 'One click from your browser. No toolchain, no drivers.' },
  { num: '3', icon: Wifi,        title: 'Connect', desc: 'Device creates a WiFi AP. Open the config page and set up.' },
  { num: '4', icon: CircleCheck, title: 'Enjoy',   desc: 'Clock, weather, news, transit, Mac and Bambu telemetry — all running on your desk.' },
];
---
<section id="setup">
  <div class="container">
    <span class="section-label">Setup</span>
    <h2>Up and running in minutes</h2>
    <p class="section-sub">
      No soldering, no SDK, no app store. Plug in, flash, configure.
    </p>

    <div class="steps-grid">
      {steps.map(({ icon: Icon, num, title, desc }) => (
        <div class="vm-card step-card">
          <span class="step-icon" aria-hidden="true"><Icon size={30} strokeWidth={1.8} /></span>
          <span class="step-num">Step {num}</span>
          <h3>{title}</h3>
          <p>{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
