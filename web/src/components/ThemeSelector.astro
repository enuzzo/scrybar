---
const themes = [
  { id: 'scrybar-default', shortLabel: 'Default' },
  { id: 'cyberpunk-2077', shortLabel: 'Cyber' },
  { id: 'toxic-candy', shortLabel: 'Toxic' },
  { id: 'tokyo-transit', shortLabel: 'Tokyo' },
  { id: 'minimal-brutalist-mono', shortLabel: 'Mono' },
  { id: 'mint-protocol', shortLabel: 'Mint' },
  { id: 'cathode-ray', shortLabel: 'CRT' },
];
---
<div class="theme-selector">
  {themes.map((t) => (
    <button
      type="button"
      class:list={['theme-pill', { active: t.id === 'scrybar-default' }]}
      aria-label={`Switch to ${t.shortLabel} theme`}
      aria-pressed={t.id === 'scrybar-default' ? 'true' : 'false'}
      data-theme-id={t.id}
    >
      <span class="theme-pill__dot"></span>
      <span class="theme-pill__label">{t.shortLabel}</span>
    </button>
  ))}
</div>

<script>
  document.querySelectorAll('.theme-pill').forEach((pill) => {
    pill.addEventListener('click', () => {
      const id = (pill as HTMLElement).dataset.themeId!;
      if (document.documentElement.dataset.theme === id) return;

      // Apply theme — CSS transitions handle the visual crossfade
      document.documentElement.setAttribute('data-theme', id);

      // Toggle active pill
      document.querySelectorAll('.theme-pill').forEach((p) => {
        const isActive = (p as HTMLElement).dataset.themeId === id;
        p.classList.toggle('active', isActive);
        p.setAttribute('aria-pressed', String(isActive));
      });

      // Toggle active screenshot
      document.querySelectorAll('.device-screen__img').forEach((img) => {
        const isActive = (img as HTMLElement).dataset.themeId === id;
        img.classList.toggle('active', isActive);
        img.setAttribute('aria-hidden', String(!isActive));
        img.setAttribute('alt', isActive ? `ScryBar ${(img as HTMLElement).dataset.themeLabel} theme preview` : '');
      });
    });
  });
</script>
