---
import { Image } from 'astro:assets';
import imgInfo from '../assets/screenshots/info_panel.png';
import imgHome from '../assets/screenshots/home_weather_scrybar-default.png';
import imgRss from '../assets/screenshots/aux_rss.png';
import imgWiki from '../assets/screenshots/wiki_stream.png';
import imgNowPlaying from '../assets/screenshots/now_playing.png';
import imgTimetable from '../assets/screenshots/timetable_board.png';
import imgLaunch from '../assets/screenshots/launch_countdown.png';
import imgMacStats from '../assets/screenshots/mac_stats.png';

const views = [
  { id: 'info',      src: imgInfo,       label: 'Diagnostics',    desc: 'IP, WiFi, battery, firmware build. The page that proves it\u2019s really on the network and not just pretending.' },
  { id: 'home',      src: imgHome,       label: 'Clock + Weather', desc: 'Natural-language time in 14 languages, forecast glyph, three-hour outlook. The face you\u2019ll actually look at.' },
  { id: 'rss',       src: imgRss,        label: 'RSS Feeds',      desc: 'Up to five feeds, favicons fetched live, QR to finish the article on your phone. Not because you\u2019ll read it \u2014 because now you can.' },
  { id: 'wiki',      src: imgWiki,       label: 'Wikipedia',      desc: 'Featured, On This Day, random discoveries. Eight languages. Trivia you didn\u2019t ask for, delivered anyway.' },
  { id: 'np',        src: imgNowPlaying, label: 'Now Playing',    desc: 'Album art, progress bar, source detection. What macOS is playing, pushed live over your LAN. Works with anything AVFoundation sees.' },
  { id: 'timetable', src: imgTimetable,  label: 'Timetable',      desc: 'Live departures from any stop worldwide via Transitous. Countdown in prime notation, like the LED at a real bus stop. No API key, no login.' },
  { id: 'launch',    src: imgLaunch,     label: 'Launches',       desc: 'Cinematic T-minus hero, weather at the pad, QR to the mission page. Know the moment SpaceX slips another window.' },
  { id: 'mac',       src: imgMacStats,   label: 'Mac Stats',      desc: 'CPU and GPU load with temperatures, RAM and disk bars. Pushed from the companion. For when Activity Monitor feels too introspective.' },
];
---
<section id="views">
  <div class="container">
    <span class="section-label">Views</span>
    <h2>Eight screens, one thumb</h2>
    <p class="section-sub">
      Swipe left or right through the carousel.
      Toggle any view off in the web UI &mdash; the order
      compresses around what\u2019s left.
    </p>

    <div class="views-grid">
      {views.map((v, i) => (
        <div class="view-card" data-view-index={i}>
          <div class="view-screen">
            <div class="view-screen__display">
              <Image
                src={v.src}
                alt={`ScryBar ${v.label} view`}
                widths={[320, 640, v.src.width]}
                sizes="(max-width: 600px) 320px, 640px"
                format="webp"
                quality={82}
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
          <h3>{v.label}</h3>
          <p>{v.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Lightbox -->
<div class="view-lightbox" id="js-view-lightbox">
  <div class="view-lightbox__inner">
    <button class="view-lightbox__close" id="js-lb-close">&times;</button>
    <button class="view-lightbox__nav view-lightbox__nav--prev" id="js-lb-prev">&lsaquo;</button>
    <button class="view-lightbox__nav view-lightbox__nav--next" id="js-lb-next">&rsaquo;</button>
    <img id="js-lb-img" src="" alt="" />
    <div class="view-lightbox__caption" id="js-lb-caption"></div>
  </div>
</div>

<script define:vars={{ views: views.map(v => ({ src: v.src.src, label: v.label })) }}>
  const lb = document.getElementById('js-view-lightbox');
  const lbImg = document.getElementById('js-lb-img');
  const lbCaption = document.getElementById('js-lb-caption');
  let currentIdx = 0;

  function openLightbox(idx) {
    currentIdx = idx;
    lbImg.src = views[idx].src;
    lbImg.alt = views[idx].label;
    lbCaption.textContent = views[idx].label;
    lb.classList.add('open');
  }

  function closeLightbox() {
    lb.classList.remove('open');
  }

  function navigate(dir) {
    currentIdx = (currentIdx + dir + views.length) % views.length;
    lbImg.src = views[currentIdx].src;
    lbImg.alt = views[currentIdx].label;
    lbCaption.textContent = views[currentIdx].label;
  }

  // Card click → open
  document.querySelectorAll('.view-card[data-view-index]').forEach((card) => {
    card.addEventListener('click', () => {
      openLightbox(parseInt(card.dataset.viewIndex, 10));
    });
  });

  // Close buttons
  document.getElementById('js-lb-close').addEventListener('click', (e) => { e.stopPropagation(); closeLightbox(); });
  lb.addEventListener('click', (e) => { if (e.target === lb) closeLightbox(); });

  // Nav
  document.getElementById('js-lb-prev').addEventListener('click', (e) => { e.stopPropagation(); navigate(-1); });
  document.getElementById('js-lb-next').addEventListener('click', (e) => { e.stopPropagation(); navigate(1); });

  // Keyboard
  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navigate(-1);
    if (e.key === 'ArrowRight') navigate(1);
  });
</script>
