---
const ALIEXPRESS_URL = 'https://aliexpress.com/w/wholesale-esp32-3.49.html?spm=a2g0o.productlist.search.0';
---
<section id="buy" class="buy-section">
  <div class="container">
    <div class="buy-card">

      <div class="buy-card__bg" aria-hidden="true"></div>

      <div class="buy-card__body">
        <div class="buy-card__left">
          <span class="buy-card__kicker">Hardware</span>
          <h2 class="buy-card__title">Get the board</h2>
          <p class="buy-card__desc">
            ScryBar runs on the <strong>Waveshare ESP32-S3 3.49&quot; AMOLED Touch</strong>
            — a $20&ndash;30 development board with a 640&times;172 AMOLED display,
            capacitive touch, IMU, and USB-C. Available on AliExpress worldwide.
          </p>
          <div class="buy-card__meta">
            <span class="buy-card__chip">ESP32-S3</span>
            <span class="buy-card__chip">640&times;172 AMOLED</span>
            <span class="buy-card__chip">~$20&ndash;30</span>
            <span class="buy-card__chip">No soldering</span>
          </div>
        </div>

        <div class="buy-card__right">
          <a
            href={ALIEXPRESS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="vm-btn vm-btn--primary buy-card__btn"
          >
            <svg class="buy-card__cart" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="M16 10a4 4 0 0 1-8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Buy on AliExpress
            <svg class="buy-card__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <p class="buy-card__hint">
            Search&nbsp;<code>esp32 3.49</code>&nbsp;— the board ships from China,
            typically 2&ndash;3 weeks.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .buy-section {
    padding: 40px 0 16px;
  }

  .buy-card {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid rgba(var(--accent-primary-rgb), 0.3);
    padding: 40px 44px;
    background: var(--bg-card);
    box-shadow:
      0 0 0 1px rgba(var(--accent-primary-rgb), 0.06) inset,
      0 20px 60px -20px rgba(var(--accent-primary-rgb), 0.2);
  }

  /* Gradient bleed in the background */
  .buy-card__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 80% at 90% 50%,
        rgba(var(--accent-primary-rgb), 0.08) 0%,
        transparent 70%),
      radial-gradient(ellipse 40% 60% at 10% 50%,
        rgba(var(--accent-secondary-rgb), 0.06) 0%,
        transparent 70%);
  }

  .buy-card__body {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 48px;
  }

  .buy-card__left {
    flex: 1;
    min-width: 0;
  }

  .buy-card__kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-primary);
    margin-bottom: 10px;
  }

  .buy-card__title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .buy-card__desc {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 18px;
    max-width: 480px;
  }

  .buy-card__desc strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .buy-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .buy-card__chip {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(var(--accent-primary-rgb), 0.08);
    border: 1px solid rgba(var(--accent-primary-rgb), 0.2);
    color: var(--text-secondary);
  }

  .buy-card__right {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .buy-card__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 54px;
    padding: 0 28px;
    font-size: 16px;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
  }

  .buy-card__btn:hover {
    opacity: 1;
  }

  .buy-card__cart {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .buy-card__arrow {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .buy-card__hint {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 220px;
  }

  .buy-card__hint code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    background: var(--bg-surface);
    padding: 1px 6px;
    border-radius: 4px;
    color: var(--text-tertiary);
  }

  @media (max-width: 760px) {
    .buy-card {
      padding: 30px 24px;
    }
    .buy-card__body {
      flex-direction: column;
      gap: 28px;
    }
    .buy-card__right {
      width: 100%;
    }
    .buy-card__btn {
      width: 100%;
      justify-content: center;
    }
    .buy-card__hint {
      max-width: none;
    }
  }
</style>
