---
import { Image } from 'astro:assets';
import imgCompanion from '../assets/screenshots/companion-app.png';
import imgIcon from '../assets/scrybar-icon.png';
---
<section id="companion" class="companion">
  <div class="container companion-container">
    <!-- Atmospheric backdrop -->
    <div class="companion-atmos" aria-hidden="true">
      <span class="companion-atmos__halo companion-atmos__halo--cyan"></span>
      <span class="companion-atmos__halo companion-atmos__halo--magenta"></span>
      <span class="companion-atmos__grid"></span>
    </div>

    <!-- Intro -->
    <header class="companion-intro">
      <span class="section-label">Companion</span>
      <h2 class="companion-headline">
        A menu bar app that makes ScryBar
        <em>know you</em>.
      </h2>
      <p class="companion-lede">
        Live Now Playing metadata, album art, CPU/GPU temperature, RAM,
        disk usage, and credential-free Bambu Lab print telemetry — streamed
        from your Mac to the strip over your LAN.
      </p>
      <div class="companion-meta">
        <span class="vm-badge vm-badge--brand">macOS 14+</span>
        <span class="vm-badge vm-badge--info">v0.3.1</span>
        <span class="companion-meta__sep" aria-hidden="true"></span>
        <span class="companion-meta__note">Menu bar · ~8 MB · Swift 6</span>
      </div>
    </header>

    <!-- Hero stage: icon + popover -->
    <div class="companion-stage">
      <div class="companion-stage__icon">
        <div class="companion-stage__iconglow" aria-hidden="true"></div>
        <Image
          src={imgIcon}
          alt="ScryBar Companion app icon"
          width={560}
          height={560}
          loading="lazy"
          class="companion-stage__iconimg"
        />
        <div class="companion-stage__iconplate" aria-hidden="true">
          <span class="companion-stage__iconplate-dot"></span>
          ScryBarCompanion.app
        </div>
      </div>

      <div class="companion-stage__bridge" aria-hidden="true">
        <span class="companion-stage__beam"></span>
      </div>

      <figure class="companion-stage__popover">
        <div class="companion-stage__chrome" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <Image
          src={imgCompanion}
          alt="ScryBar Companion popover: Now Playing + live Mac Stats"
          width={345}
          height={377}
          loading="lazy"
          class="companion-stage__popoverimg"
        />
        <figcaption class="companion-stage__caption">
          <span class="companion-stage__pulse" aria-hidden="true"></span>
          Pushing to ScryBar over LAN
        </figcaption>
      </figure>
    </div>

    <!-- Primary CTA row -->
    <div class="companion-cta">
      <a
        href="https://github.com/enuzzo/scrybar/releases/download/v0.9.0/ScryBarCompanion-0.3.1.dmg"
        class="vm-btn vm-btn--primary vm-btn--lg companion-cta__btn"
      >
        <span class="companion-cta__arrow" aria-hidden="true">↓</span>
        Download stable DMG
        <span class="companion-cta__ver">v0.3.1</span>
      </a>
      <span class="companion-cta__hint">
        Ad-hoc signed · Apple Silicon + Intel · ~8 MB
      </span>
    </div>

    <!-- Prerequisite: macmon for CPU/GPU temps on Apple Silicon -->
    <aside class="companion-prereq">
      <span class="companion-prereq__tag">heads up</span>
      <div class="companion-prereq__body">
        <strong>Live CPU/GPU temperatures need one Homebrew dependency.</strong>
        On Apple Silicon, install
        <a
          href="https://github.com/vladkens/macmon"
          target="_blank"
          rel="noopener"
        >macmon</a> — a small open-source CLI that reads M1–M4 sensors
        through the same IOKit channel Apple uses internally, no
        <code>sudo</code>, no kernel extension:
        <pre class="companion-prereq__cmd"><code>brew install macmon</code></pre>
        Without it the popover still streams CPU/GPU <em>usage %</em>, RAM,
        and disk — temperatures just read as <code>—</code>.
      </div>
    </aside>

    <!-- First-launch flow -->
    <div class="companion-flow">
      <div class="companion-flow__head">
        <span class="companion-flow__kicker">First launch</span>
        <h3 class="companion-flow__title">Four taps to menu bar.</h3>
        <p class="companion-flow__sub">
          The app is ad-hoc signed (no paid Developer ID), so Gatekeeper
          blocks it on first open. This is a one-time step — after that,
          launches are instant.
        </p>
      </div>

      <ol class="companion-steps">
        <li class="companion-step">
          <span class="companion-step__num">01</span>
          <h4 class="companion-step__title">Mount &amp; drag</h4>
          <p class="companion-step__body">
            Open the <code>.dmg</code> and drop
            <strong>ScryBarCompanion.app</strong> into
            <code>/Applications</code>.
          </p>
        </li>
        <li class="companion-step">
          <span class="companion-step__num">02</span>
          <h4 class="companion-step__title">First launch blocked</h4>
          <p class="companion-step__body">
            Double-click — macOS says <em>"cannot be opened because Apple
            cannot check it for malicious software."</em> Expected.
          </p>
        </li>
        <li class="companion-step">
          <span class="companion-step__num">03</span>
          <h4 class="companion-step__title">Open Anyway</h4>
          <p class="companion-step__body">
            <strong>System Settings → Privacy &amp; Security</strong>,
            scroll to the blocked-app notice, click
            <strong>Open Anyway</strong>, confirm with password.
          </p>
        </li>
        <li class="companion-step">
          <span class="companion-step__num">04</span>
          <h4 class="companion-step__title">It lives in your menu bar</h4>
          <p class="companion-step__body">
            The ScryBar glyph appears top-right. Future launches are
            instant. Quit from the popover menu anytime.
          </p>
        </li>
      </ol>

      <!-- Mini terminal shortcut -->
      <div class="companion-terminal">
        <div class="companion-terminal__bar">
          <span class="companion-terminal__dots" aria-hidden="true">
            <i></i><i></i><i></i>
          </span>
          <span class="companion-terminal__title">zsh — shortcut</span>
          <span class="companion-terminal__badge">skip Gatekeeper</span>
        </div>
        <pre class="companion-terminal__body"><code><span class="companion-terminal__prompt">$</span> xattr -dr com.apple.quarantine /Applications/ScryBarCompanion.app
<span class="companion-terminal__prompt">$</span> open /Applications/ScryBarCompanion.app</code></pre>
      </div>
    </div>
  </div>
</section>
